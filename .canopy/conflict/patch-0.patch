+		t.Fatalf("Failed to create client: %v", err)
+	}
+	defer client.Close()
+
+	// Simulate resolver start event (child of original agent)
+	parentAgentID := "agent-canopy-test"
+	resolverAgentID := "canopy-test-resolver"
